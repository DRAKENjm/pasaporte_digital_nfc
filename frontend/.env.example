# Proxy de Vite en desarrollo; reverse proxy /api en producción
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=
# Map ID vectorial (habilita rotación con 2 dedos en móvil) — crear en console.cloud.google.com/google/maps-apis/studio/maps
VITE_GOOGLE_MAPS_MAP_ID=
VITE_APP_NAME="Pasaporte NFC"