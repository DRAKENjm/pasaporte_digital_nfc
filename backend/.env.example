PORT=5000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/pasaporte_nfc_db
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Solo para pruebas locales. En producción la verificación siempre se requiere.
REQUIRE_EMAIL_VERIFICATION=false
SMTP_USER=
SMTP_PASS=
GOOGLE_CLIENT_ID=
